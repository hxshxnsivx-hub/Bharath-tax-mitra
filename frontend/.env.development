# Local development environment (loaded ONLY by `vite dev`, never by production builds).
# Points the frontend at the local FastAPI mock server started by `npm run dev:local`.
# Do NOT put production URLs here — see .env.example for the production template.
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_ENV=development
