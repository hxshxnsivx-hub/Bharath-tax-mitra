# API Configuration
VITE_API_URL=https://api.bharattaxmitra.in
VITE_WS_URL=wss://api.bharattaxmitra.in

# Environment
VITE_ENV=development

# Dev-only OTP bypass. NEVER set this for a deployed environment — it is ignored
# outside `vite dev` (gated on import.meta.env.DEV), but do not add it here.
# VITE_DEV_AUTOLOGIN=true

# Feature Flags
VITE_ENABLE_AI_EXTRACTION=true
VITE_ENABLE_CHAT_ASSISTANT=true

# Analytics (Optional)
VITE_ANALYTICS_ID=

# Sentry (Optional)
VITE_SENTRY_DSN=
