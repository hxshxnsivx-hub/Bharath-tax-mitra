{
  "name": "@bharat-tax-mitra/infrastructure",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy --all --context env=dev --require-approval never",
    "deploy:staging": "cdk deploy --all --context env=staging",
    "deploy:prod": "cdk deploy --all --context env=prod",
    "deploy:stack": "cdk deploy --context env=dev",
    "diff:dev": "cdk diff --all --context env=dev",
    "diff:prod": "cdk diff --all --context env=prod",
    "synth:dev": "cdk synth --context env=dev",
    "destroy:dev": "cdk destroy --all --context env=dev --force",
    "bootstrap:dev": "cdk bootstrap --context env=dev",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.115.0",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.115.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
