{
  "environment": "prod",
  "region": "ap-south-1",
  "account": "REPLACE_WITH_AWS_ACCOUNT_ID",
  "stackName": "BharatTaxMitra-Prod",
  "domainName": "bharattaxmitra.in",
  "certificateArn": "",
  "enableWaf": true,
  "enableXray": true,
  "logRetentionDays": 90,
  "lambdaMemory": {
    "auth": 1024,
    "taxCalculation": 2048,
    "extraction": 3008
  },
  "lambdaTimeout": {
    "auth": 10,
    "taxCalculation": 30,
    "extraction": 60
  },
  "dynamoDb": {
    "billingMode": "PAY_PER_REQUEST",
    "pointInTimeRecovery": true
  },
  "s3": {
    "lifecycleDays": 1,
    "versioningEnabled": true
  },
  "alarms": {
    "errorRateThreshold": 5,
    "latencyThreshold": 3000,
    "snsTopicArn": ""
  }
}
