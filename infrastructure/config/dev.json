{
  "environment": "dev",
  "region": "ap-south-1",
  "account": "REPLACE_WITH_AWS_ACCOUNT_ID",
  "stackName": "BharatTaxMitra-Dev",
  "domainName": "dev.bharattaxmitra.in",
  "certificateArn": "",
  "enableWaf": false,
  "enableXray": true,
  "logRetentionDays": 7,
  "lambdaMemory": {
    "auth": 512,
    "taxCalculation": 1024,
    "extraction": 2048
  },
  "lambdaTimeout": {
    "auth": 10,
    "taxCalculation": 30,
    "extraction": 60
  },
  "dynamoDb": {
    "billingMode": "PAY_PER_REQUEST",
    "pointInTimeRecovery": false
  },
  "s3": {
    "lifecycleDays": 1,
    "versioningEnabled": false
  }
}
